# App
CHATBOT_JWT_SECRET=replace-with-a-long-random-secret
CHATBOT_JWT_ALGORITHM=HS256
CHATBOT_ALLOW_DEV_TOKEN_AUTH=false
CHATBOT_LOCAL_LOGIN_ENABLED=true
CHATBOT_JWT_CLAIM_TENANT_ID=tenant_id
CHATBOT_JWT_CLAIM_USER_ID=user_id
CHATBOT_JWT_CLAIM_ROLE=role
CHATBOT_JWT_CLAIM_SUB_FALLBACK_ENABLED=true
CHATBOT_JWT_ISSUER=
CHATBOT_JWT_AUDIENCE=

# SQL Server
CHATBOT_SQLSERVER_HOST=127.0.0.1
CHATBOT_SQLSERVER_PORT=1433
CHATBOT_SQLSERVER_USER=sa
CHATBOT_SQLSERVER_PASSWORD="StrongPass123!"
CHATBOT_SQLSERVER_DB=chatbot_test_db
CHATBOT_SQLSERVER_DRIVER="ODBC Driver 18 for SQL Server"
CHATBOT_SQLSERVER_ENCRYPT=no
CHATBOT_SQLSERVER_TRUST_CERT=yes
CHATBOT_DATABASE_URL=
CHATBOT_TENANT_ISOLATION_ENFORCED=true
CHATBOT_DB_FALLBACK_TO_MOCK=false

# Rate limiting and alerts
CHATBOT_RATE_LIMIT_ENABLED=true
CHATBOT_RATE_LIMIT_WINDOW_SECONDS=60
CHATBOT_RATE_LIMIT_REQUESTS_PER_WINDOW=120
CHATBOT_RATE_LIMIT_CHAT_REQUESTS_PER_WINDOW=30
CHATBOT_ALERT_ERROR_RATE_PERCENT_THRESHOLD=5
CHATBOT_ALERT_AVG_LATENCY_MS_THRESHOLD=1200

# External research and tenant policy
CHATBOT_EXTERNAL_RESEARCH_ENABLED=true
CHATBOT_EXTERNAL_RESEARCH_ALLOWLIST=www.rbi.org.in,www.sebi.gov.in,www.investopedia.com
CHATBOT_ENABLE_V2=false
CHATBOT_V2_RESEARCH_PROVIDER=skeleton
CHATBOT_TENANT_DOMAIN_MAP=tnt_demo:finance,tnt_other:event
CHATBOT_DEFAULT_DOMAIN=
